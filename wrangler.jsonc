{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biosynanalytical",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_EMAILJS_SERVICE_ID": "service_25avute",
    "NEXT_PUBLIC_EMAILJS_TEMPLATE_ID": "template_gec6t7d",
    "NEXT_PUBLIC_EMAILJS_PUBLIC_KEY": "ZXLfR2Rj9Db26KWby"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
